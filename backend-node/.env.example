# ==========================================================================
# RUSH REPUBLIC — NODE BACKEND ENVIRONMENT VARIABLES
# Same names as the Django backend's .env wherever possible, so the existing
# values can be copied across. Placeholders only — never commit a real .env.
# ==========================================================================

NODE_ENV=production
# Hostinger injects PORT for Node.js web apps; 3000 is only the local default.
PORT=3000

# WARNING: false = NO sign-in; anyone who can open the site controls the scheduler and
# the connected Instagram accounts. Protect the site (e.g. hPanel > Password Protect Directories) if public.
AUTH_REQUIRED=false
DEFAULT_USER_EMAIL=admin@rushrepublic.com

# Secret used to sign/verify JWTs. Use the SAME value as the Django
# DJANGO_SECRET_KEY to keep already-issued tokens valid (JWT_SECRET wins if set).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# JWT_SECRET=

# Fernet key that encrypts Instagram access tokens at rest. MUST be the same
# key the Django backend used, or stored tokens cannot be decrypted.
FIELD_ENCRYPTION_KEY=

# --- Database (existing MySQL) ---
DB_NAME=rush_scheduler
DB_USER=rush_user
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# --- Meta / Instagram Graph API ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v20.0
META_REDIRECT_URI=https://api.your-domain.com/api/instagram/oauth/callback/
META_PUBLISHING_ENABLED=False

# Public https URL of THIS backend; Meta fetches media from it (/media/...).
PUBLIC_MEDIA_BASE_URL=https://api.your-domain.com

# --- Media storage ---
# Absolute path to a persistent folder (must survive redeploys). Contains content/<user_id>/<file>.
MEDIA_ROOT=/home/USER/rush-media

# --- Scheduler (replaces Celery) ---
# In-process poller; the hPanel cron job (scripts/run-due-jobs.js) is the reliable trigger.
ENABLE_INPROCESS_SCHEDULER=true
SCHEDULER_POLL_SECONDS=30
# PROCESSING rows older than this are marked FAILED (worker killed mid-publish).
STUCK_PROCESSING_MINUTES=30
