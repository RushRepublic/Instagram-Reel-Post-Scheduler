{
  "name": "rush-republic-scheduler-api",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express backend for the Rush Republic Instagram Scheduler (replaces Django/DRF; same MySQL schema and API contract).",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "run-due-jobs": "node scripts/run-due-jobs.js",
    "seed-demo-user": "node scripts/seed-demo-user.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3"
  }
}
