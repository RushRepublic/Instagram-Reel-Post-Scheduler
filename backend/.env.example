# ==========================================================================
# RUSH REPUBLIC — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key used to encrypt Instagram access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database (MySQL, via Docker) ---
# Default host port is 3307, not 3306 — many dev machines already have a
# native MySQL install bound to 3306 (see docker-compose.yml). Change back
# to 3306 if that port is actually free on your machine.
DB_NAME=rush_scheduler
DB_USER=rush_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- CORS (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Meta / Instagram Graph API ---
# Create an App at https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v20.0
META_REDIRECT_URI=http://localhost:8000/api/instagram/oauth/callback/

# Safety switch — publishing task will NOT call Meta endpoints while False.
# Only set to True after you have explicitly reviewed and authorized a live test.
META_PUBLISHING_ENABLED=False

# Base URL the backend is reachable at from the public internet, used to build
# server-accessible media URLs Meta's servers can fetch (e.g. via ngrok in dev).
# Example: https://abcd1234.ngrok-free.app
PUBLIC_MEDIA_BASE_URL=
